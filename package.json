{
  "name": "blick-widgets-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:poll": "npm run dev -w apps/poll",
    "build:poll": "node scripts/build.mjs poll",
    "dev:calendar": "npm run dev -w apps/calendar",
    "build:calendar": "node scripts/build.mjs calendar",
    "dev:folder": "npm run dev -w apps/folder",
    "build:folder": "node scripts/build.mjs folder",
    "dev:teaser": "npm run dev -w apps/teaser",
    "build:teaser": "node scripts/build.mjs teaser",
    "dev:docs": "npm run dev -w apps/docs",
    "build:docs": "npm run build -w apps/docs",
    "dev:utils": "npm run dev -w apps/utils",
    "build:utils": "npm run build -w apps/utils",
    "dev:facts": "npm run dev -w apps/facts",
    "build:facts": "node scripts/build.mjs facts",
    "dev:potm": "npm run dev -w apps/potm",
    "build:potm": "node scripts/build.mjs potm",
    "dev:prono": "npm run dev -w apps/prono",
    "build:prono": "node scripts/build.mjs prono",
    "dev:quiz": "npm run dev -w apps/quiz",
    "build:quiz": "node scripts/build.mjs quiz",
    "dev:natinotes": "npm run dev -w apps/natinotes",
    "build:natinotes": "node scripts/build.mjs natinotes",
    "dev:testimony": "npm run dev -w apps/testimony",
    "build:testimony": "node scripts/build.mjs testimony",
    "dev:tinder": "npm run dev -w apps/tinder",
    "build:tinder": "node scripts/build.mjs tinder",
    "dev:backend": "npm run dev -w apps/backend",
    "build:backend": "node scripts/build.mjs backend",
    "dev:api": "npm run dev -w apps/api",
    "test:api": "npm test -w apps/api",
    "test:widget-model": "npm test -w packages/widget-model",
    "rules:pull:prod": "node firebase/pull-rules.mjs prod",
    "rules:deploy:prod": "node firebase/check-rules.mjs prod && firebase deploy --only firestore:rules,storage --config firebase/firebase.prod.json --project prod",
    "rules:deploy:test": "node firebase/check-rules.mjs test && firebase deploy --only firestore:rules,storage --config firebase/firebase.test.json --project test",
    "rules:check:prod": "node firebase/check-rules.mjs prod",
    "rules:check:dev": "node firebase/check-rules.mjs dev",
    "rules:check:test": "node firebase/check-rules.mjs test",
    "rules:deploy:dev": "node firebase/check-rules.mjs dev && node firebase/publish-rules-dev.mjs"
  },
  "devDependencies": {
    "firebase-tools": "^15.36.0"
  }
}
